{
  "name": "@ktr-srt/util",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build:clean": "rm -rf dist && yarn build:esm && yarn build:cjs",
    "build": "yarn build:esm && yarn build:cjs",
    "build:esm": "esbuild src/index.js --format=esm --platform=node --outfile=dist/index.js",
    "build:cjs": "node build-cjs.cjs",
    "test": "mocha test --recursive --reporter spec --exit --timeout 10000",
    "test:importing": "yarn mocha --recursive test/tests/importing --reporter spec --exit"
  },
  "imports": {
    "#projectRoot": "./",
    "#projectRoot/*": "./*.js",
    "#src": "./src/index.js",
    "#src/*": "./src/*.js"
  },
  "dependencies": {
    "date-fns": "^2.29.3",
    "date-fns-tz": "^1.3.7",
    "date-holidays": "^3.16.11",
    "dotenv": "^16.0.3",
    "nodemailer": "^6.8.0"
  },
  "devDependencies": {
    "@yarnpkg/esbuild-plugin-pnp": "^3.0.0-rc.15",
    "chai": "^4.3.7",
    "esbuild": "^0.25.3",
    "mocha": "^10.1.0"
  }
}