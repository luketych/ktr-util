{
  "name": "ktr-util",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build:clean": "rm -rf dist && yarn build:esm && yarn build:cjs",
    "build": "yarn build:esm && yarn build:cjs",
    "build:esm": "esbuild src/index.js --format=esm --platform=node --outfile=dist/index.js",
    "build:cjs": "node build-cjs.cjs",
    "test": "yarn mocha test/tests --recursive --reporter spec --exit --timeout 10000",
    "test:importing": "yarn mocha --recursive test-importing/tests --reporter spec --exit"
  },
  "imports": {
    "#projectRoot": "./",
    "#projectRoot/*": "./*.js",
    "#src": "./src/index.js",
    "#src/*": "./src/*.js"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "date-fns": "^2.29.3",
    "date-fns-tz": "^1.3.7",
    "date-holidays": "^3.16.11",
    "debug": "^4.4.0",
    "dotenv": "^16.0.3",
    "fast-glob": "^3.3.3",
    "nodemailer": "^6.8.0",
    "supports-color": "^10.0.0"
  },
  "devDependencies": {
    "@yarnpkg/esbuild-plugin-pnp": "^3.0.0-rc.15",
    "chai": "^4.3.7",
    "esbuild": "^0.25.3",
    "mocha": "^10.1.0"
  }
}
