{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🧹🔧 clean_and_build:all",
      "runtimeExecutable": "npm",
      "runtimeArgs": [ "run", "clean_and_build:all" ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }, {
      "type": "node",
      "request": "launch",
      "name": "🔨🏠 build:all",
      "runtimeExecutable": "npm",
      "runtimeArgs": [ "run", "build:all" ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }, {
      "type": "node",
      "request": "launch",
      "name": "🔨📦 build:esm",
      "runtimeExecutable": "npm",
      "runtimeArgs": [ "run", "build:esm" ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }, {
      "type": "node",
      "request": "launch",
      "name": "🔨📦 build:cjs",
      "runtimeExecutable": "npm",
      "runtimeArgs": [ "run", "build:cjs" ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }, {
      "type": "node",
      "request": "launch",
      "name": "🔨🧪 build_and_test",
      "runtimeExecutable": "npm",
      "runtimeArgs": [ "run", "build_and_test" ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }, {
      "type": "node",
      "request": "launch",
      "name": "🧪🚀 test:main",
      "runtimeExecutable": "npm",
      "runtimeArgs": [ "run", "test:main" ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }, 
    {
      "name": "🧪🔧 test-importing:setup",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/test-importing",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [ "run", "setup" ],
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧪🚀 test-importing:run",
      "runtimeExecutable": "npm",
      "runtimeArgs": [ "run", "test-importing" ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}